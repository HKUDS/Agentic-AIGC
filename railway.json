{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "fitness_coach/Dockerfile"
  },
  "deploy": {
    "startCommand": "python -m fitness_coach",
    "numReplicas": 1,
    "restartPolicyType": "ALWAYS",
    "sleepApplication": false
  }
}
