# --- Required ---------------------------------------------------------------
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# --- AI coach (optional) -----------------------------------------------------
# Any OpenAI-compatible endpoint. Without a key the bot still works and answers
# from its built-in knowledge base.
FITNESS_LLM_API_KEY=
FITNESS_LLM_BASE_URL=https://api.openai.com/v1
FITNESS_LLM_MODEL=gpt-4o-mini
FITNESS_LLM_TIMEOUT=60

# --- Subscription ------------------------------------------------------------
# Price in Telegram Stars and the period a single purchase grants.
FITNESS_PRO_PRICE_STARS=250
FITNESS_PRO_PERIOD_DAYS=30
# Comma-separated single-use-per-user promo codes.
FITNESS_PROMO_CODES=WELCOME,FRIEND2026

# --- Operations --------------------------------------------------------------
FITNESS_DB_PATH=.fitness_coach/bot.sqlite3
# Telegram ids allowed to run /stats and /grant.
FITNESS_ADMIN_IDS=
FITNESS_REMINDER_TICK=30
FITNESS_POLL_TIMEOUT=30

# --- Web sign-up page ---------------------------------------------------------
FITNESS_WEB_ENABLED=1
FITNESS_BOT_ENABLED=1
# Railway sets PORT itself; this is the local fallback.
FITNESS_WEB_PORT=8080
# Signs session tokens and verification codes. Generate once and keep it:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FITNESS_SECRET_KEY=
# Bot username without @, used for the "connect Telegram" deep link.
FITNESS_BOT_USERNAME=
FITNESS_PUBLIC_URL=

# Email codes over SMTP. Without these, codes are only written to the log.
FITNESS_SMTP_HOST=
FITNESS_SMTP_PORT=587
FITNESS_SMTP_USER=
FITNESS_SMTP_PASSWORD=
FITNESS_SMTP_FROM=
FITNESS_SMTP_TLS=1

# SMS codes: any endpoint accepting {"phone": ..., "text": ...}.
FITNESS_SMS_WEBHOOK_URL=
FITNESS_SMS_WEBHOOK_TOKEN=

# DEVELOPMENT ONLY: returns the code in the API response so the flow can be
# tested without a provider. Never enable in production.
FITNESS_DEV_SHOW_CODE=0
